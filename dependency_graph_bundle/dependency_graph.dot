digraph dependencies {
graph [rankdir=TB, bgcolor="transparent", compound=true, pad=0.15, nodesep=0.18, ranksep=0.42, fontname="DejaVu Sans", fontsize=18, splines=polyline, outputorder=edgesfirst, pack=true, packmode="array_3"];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, fontcolor="#17212B", margin="0.14,0.10", penwidth=1.15];
edge [color="#647488", penwidth=1.05, arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
subgraph cluster_factorials {
label="2.2  Конкатенация факториалов"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"E1" [label="[3] Текст перед леммой 2.2.1\n«log(n!) не равномерно\nраспределён mod 1»\nс. 43", fillcolor="#FFD5BD", color="#CC5200", tooltip="Утверждение неверно. Для любого фиксированного b>1 дробные части log_b(n!) равномерно распределены. В доказательстве леммы 2.2.1 это отрицательное утверждение не используется. | с. 43; строка 924 TeX", id="node-E1"];
"F1" [label="[0] Лемма 2.2.1\nБесконечно много попаданий\nв каждый интервал mod 1\nс. 43–44", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 2.2.1 | с. 43–44", id="node-F1"];
"F2" [label="[0] Лемма 2.2.2\nЗаданный ненулевой префикс\nв записи n!\nс. 44", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 2.2.2 | с. 44", id="node-F2"];
"F3" [label="[0] Лемма 2.2.3\nПроизвольно длинный\nконцевой блок нулей\nс. 44", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 2.2.3 | с. 44", id="node-F3"];
"F4" [label="[0] Предл. 2.2.2\np(k) ≤ a(k) ≤ b^k\nс. 45", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 2.2.2 | с. 45", id="node-F4"];
"F5" [label="[0] Теорема 2.2.3\nПолная факторная и\nарифметическая сложность\nс. 45–46", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 2.2.3 | с. 45–46", id="node-F5"];
}
subgraph cluster_prelim {
label="3.1  Ошибки предварительного раздела"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"E2" [label="[1] Формула (3.4)\nВторая сумма равна F(n+1),\nа не F(n)\nс. 49", fillcolor="#FFF3C4", color="#B78300", tooltip="При F0=0, F1=1 две напечатанные суммы дают при n=3 значения 2 и 3. Это локальная ошибка индексации. В показанных доказательствах используется отдельная рекурсия / формула Бине. | с. 49; формула (3.4)", id="node-E2"];
"E3" [label="[4] Определение 3.1.2\nПри k=3, p=1:\nF₁¹(t,3)=0 и F₁¹(t,3)=1\nс. 49", fillcolor="#FBC9D0", color="#B51F37", tooltip="Начальные условия (3.8) противоречат друг другу. Объект в напечатанном определении не существует для этих разрешённых параметров. Уровень 4 относится к этому определению, а не ко всей диссертации. | с. 49; формулы (3.7), (3.8)", id="node-E3"];
"A1" [label="[2] Лемма 3.1.1\nПроизводящая функция (3.11)\nдля объекта из опр. 3.1.2\nс. 50", fillcolor="#FFE3AC", color="#C47700", tooltip="Формула относится к последовательности из противоречивого определения. До исправления определения утверждение нельзя принимать в текущей форме. Это не самостоятельное доказательство ложности формулы после восстановления правильных условий. | с. 50; формула (3.11)", id="node-A1"];
"E4" [label="[3] Теорема 3.1.1\n(3.13): 2·limsup[…] вместо\n2 + limsup[…] при смысле E*\nс. 50–51", fillcolor="#FFD5BD", color="#CC5200", tooltip="ind и ind* не определены. Если ind* означает асимптотический критический показатель, множитель 2 ошибочен: нужен 2+limsup. Для Фибоначчи получаются 2φ и 2+φ соответственно. Эту формулу последующие показанные доказательства не используют. | с. 50–51; формула (3.13)", id="node-E4"];
}
subgraph cluster_fibonacci {
label="3.4–3.5  Буквы, механическое описание, обрамления"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"B0" [label="[И] Рекурсия слова Фибоначчи\ns₀=0, s₁=01;\nsₙ=sₙ₋₁sₙ₋₂", fillcolor="#EEF1F5", color="#748193", tooltip="Фиксированное исходное определение классического слова, использованное в разных частях текста.", id="node-B0", shape="ellipse", fontsize="11"];
"B1" [label="[0] Предл. 3.4.1\nМеханическое представление\nбукв слова Фибоначчи\nс. 57", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.4.1 | с. 57", id="node-B1"];
"B2" [label="[0] Теорема 3.4.2\nТочный подсчёт букв\nи оптимальное отклонение\nс. 57–58", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.4.2 | с. 57–58", id="node-B2"];
"B3" [label="[0] Предл. 3.4.3\nСбалансированность\nвсех факторов\nс. 59–60", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.4.3 | с. 59–60", id="node-B3"];
"B4" [label="[0] Леммы 3.5.1 → 3.5.2\nПозиции Битти;\nзапрет факторов 11 и 000\nс. 66–67", fillcolor="#E7F2E9", color="#338153", tooltip="Леммы 3.5.1 → 3.5.2 | с. 66–67", id="node-B4"];
"B5" [label="[0] Предл. 3.5.3 → 3.5.4\nКоличество букв\nв uₘ и qₘ=a uₘ b\nс. 69", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.5.3 → 3.5.4 | с. 69", id="node-B5"];
"B6" [label="[0] Лемма 3.1.2\nТождества Бине\nи предельные отношения\nс. 52", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 3.1.2 | с. 52", id="node-B6"];
"B7" [label="[0] Теорема 3.5.5\nТочная погрешность плотности\nв обрамлённых словах\nс. 70", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.5.5 | с. 70", id="node-B7"];
{rank=same; "B0"; "B1"; "B6";}
{rank=same; "B5"; "B2"; "B3"; "B4";}
{rank=same; "B7";}
"B0" -> "B5" [style=invis, weight=25];
"B5" -> "B7" [style=invis, weight=25];
}
subgraph cluster_palindromes {
label="3.6  Палиндромы"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"C1" [label="[0] Лемма 3.6.1\nЯвные палиндромные\nпрефиксы Фибоначчи\nс. 74–75", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 3.6.1 | с. 74–75", id="node-C1"];
"C2" [label="[0] Теорема 3.6.2 (Фишлер)\ndensₚ(w) ≤ 1/φ\nдля непериодического w\nс. 74", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.6.2 (Фишлер) | с. 74", id="node-C2"];
"C3" [label="[0] Теорема 3.6.3\ndensₚ(f)=1/φ\nс. 75", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.6.3 | с. 75", id="node-C3"];
"C4" [label="[1] Лемма 3.6.2\ny = ι₀(ρ(f))\n[1: вложенность лишь с n=1]\nс. 77–78", fillcolor="#FFF3C4", color="#B78300", tooltip="Обнаружена дополнительная граничная неточность: y₀=01 не является префиксом y₁=02. Утверждение о вложенности верно для n≥1. Предельное кодирование y=ι₀(ρ(f)) сохраняется; в доказательстве богатства y₀ нужно рассмотреть отдельно или использовать, что s₋₁=1 является фактором f. | с. 77–78; лемма 3.6.2", id="node-C4"];
"C5" [label="[0] Лемма 3.6.3\nДлины палиндромных\nпрефиксов: m → 2m+1\nс. 78", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 3.6.3 | с. 78", id="node-C5"];
"C6" [label="[0] Предл. 3.6.7\nВставка нуля\nсохраняет densₚ\nс. 78–79", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.6.7 | с. 78–79", id="node-C6"];
"C7" [label="[0] Теорема 3.6.8\nПрефиксы y: 2Fₖ−3;\ndensₚ(y)=1/φ\nс. 79", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.6.8 | с. 79", id="node-C7"];
"C8" [label="[0] Лемма 3.6.4\nПодсчёт палиндромов\nпри вставке разделителя\nс. 79–80", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 3.6.4 | с. 79–80", id="node-C8"];
"C9" [label="[0] Теорема 3.6.10\nБогатство yₙ\nи всех факторов y\nс. 80", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.6.10 | с. 80", id="node-C9"];
"C10" [label="[0] Теоремы 3.6.12 → 3.6.13\nСписок префиксов;\nформула Фишлера через CF\nс. 81", fillcolor="#E7F2E9", color="#338153", tooltip="Теоремы 3.6.12 → 3.6.13 | с. 81", id="node-C10"];
"C11" [label="[0] Предл. 3.6.14; след. 3.6.15\nДихотомия плотности\nи её следствия\nс. 81–83", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.6.14; след. 3.6.15 | с. 81–83", id="node-C11"];
"C12" [label="[И] Классические факты\nВсе палиндромные префиксы f;\nбогатство штурмовых факторов", fillcolor="#EEF1F5", color="#748193", tooltip="Полнота списка префиксов берётся из классической литературы, а не из одной леммы 3.6.1.", id="node-C12", shape="ellipse", fontsize="11"];
{rank=same; "C1"; "C2"; "C12";}
{rank=same; "C3"; "C4"; "C5";}
{rank=same; "C6"; "C7"; "C8";}
{rank=same; "C9"; "C10";}
{rank=same; "C11";}
"C1" -> "C3" [style=invis, weight=25];
"C3" -> "C6" [style=invis, weight=25];
"C6" -> "C9" [style=invis, weight=25];
"C9" -> "C11" [style=invis, weight=25];
}
subgraph cluster_twisted {
label="3.8  Скрученные повторы и динамика"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"D0" [label="[0] Предл. 3.8.1 / 3.8.4\nW[n]=s_b(n) mod N\nс. 90–91, 93", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.8.1 / 3.8.4 | с. 90–91, 93", id="node-D0"];
"D1" [label="[0] Лемма 3.8.4\nПовторы ↔ постоянство cₘ;\nарифметика переносов\nс. 93–94", fillcolor="#E7F2E9", color="#338153", tooltip="Лемма 3.8.4 | с. 93–94", id="node-D1"];
"D2" [label="[0] Леммы 3.8.1–3.8.3\nДвоичный случай:\nредукция длины блока\nс. 91–92", fillcolor="#E7F2E9", color="#338153", tooltip="Леммы 3.8.1–3.8.3 | с. 91–92", id="node-D2"];
"D3" [label="[0] Теорема 3.8.2\nКлассификация\nскрученных кубов при b=2\nс. 92", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.8.2 | с. 92", id="node-D3"];
"E5" [label="[1] Теорема 3.8.5\nПолная классификация κ\n[1: поправка в доказательстве]\nс. 94–95", fillcolor="#FFF3C4", color="#B78300", tooltip="В конце шага 2 при j'≥b неверно написано floor(2b/j')≤1; нужно ≤2. Значение κ=max{2,floor(2b/j')} и вывод теоремы сохраняются. | с. 94–95; последняя строка доказательства", id="node-E5"];
"D4" [label="[0] Следствие 3.8.6\nНепериодичность;\nчастные случаи классификации\nс. 95–96", fillcolor="#E7F2E9", color="#338153", tooltip="Следствие 3.8.6 | с. 95–96", id="node-D4"];
"D5" [label="[0] Теорема 3.8.7 (1,2,4,5)\nПримитивность, минимальность,\nчастоты, строгая эргодичность\nс. 96–97", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.8.7 (1,2,4,5) | с. 96–97", id="node-D5"];
"D6" [label="[0] Теорема 3.8.7 (3)\nНепериодичность,\nлинейная сложность, h=0\nс. 96–97", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 3.8.7 (3) | с. 96–97", id="node-D6"];
"D7" [label="[0] Следствие 3.8.8\nЗапрет повторов\nна всём подсдвиге X_W\nс. 97", fillcolor="#E7F2E9", color="#338153", tooltip="Следствие 3.8.8 | с. 97", id="node-D7"];
"N1" [label="[Н] Наблюдение 3.8.3\nТочная закономерность p(n)\nоставлена открытым вопросом\nс. 93, 98, 134", fillcolor="#E9DDF6", color="#8054A6", tooltip="Полная факторная сложность s₂(n) mod N вычислена Tromp–Shallit (1995). Требуется сопоставление с известной формулой; вычислительное наблюдение само по себе не объявляется ложным. | с. 93, 98, 134", id="node-N1"];
"D8" [label="[И] Внешние классические факты\nПримитивные подстановки;\nтеорема Морса–Хедлунда", fillcolor="#EEF1F5", color="#748193", tooltip="Внешние классические факты", id="node-D8", shape="ellipse", fontsize="11"];
"D9" [label="[И] Tromp–Shallit, 1995\nФакторная сложность\ns₂(n) mod N", fillcolor="#EEF1F5", color="#748193", tooltip="Tromp–Shallit, 1995", id="node-D9", shape="ellipse", fontsize="11"];
{rank=same; "D9"; "D0"; "D8";}
{rank=same; "N1"; "D1"; "D2";}
{rank=same; "E5"; "D5"; "D3";}
{rank=same; "D4"; "D7";}
{rank=same; "D6";}
"D9" -> "N1" [style=invis, weight=25];
"N1" -> "E5" [style=invis, weight=25];
"E5" -> "D4" [style=invis, weight=25];
"D4" -> "D6" [style=invis, weight=25];
}
subgraph cluster_trees {
label="5.1  Деревья и индексы"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"G0" [label="[И] Штурмов язык\np(k)=k+1;\nправый специальный фактор rₖ", fillcolor="#EEF1F5", color="#748193", tooltip="Штурмов язык", id="node-G0", shape="ellipse", fontsize="11"];
"G1" [label="[0] Предл. 5.1.1\nНижняя оценка\nirr₂(T) ≥ Δ(Δ²−1)\nс. 126", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 5.1.1 | с. 126", id="node-G1"];
"G2" [label="[0] Предл. 5.1.2\nПуть минимизирует irr₂\nс. 126", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 5.1.2 | с. 126", id="node-G2"];
"G3" [label="[0] Теорема 5.1.3\nИндексы дерева факторов\nштурмова слова\nс. 128–129", fillcolor="#E7F2E9", color="#338153", tooltip="Теорема 5.1.3 | с. 128–129", id="node-G3"];
"N2" [label="[Н] Гипотеза 1\nЗвезда максимизирует irr₂\n[Н: уже есть простое доказательство]\nс. 126–127, заключение", fillcolor="#E9DDF6", color="#8054A6", tooltip="Утверждение истинно: каждое ребро даёт не более Δ²−1, а для незвезды Δ≤n−2. Требуется заменить гипотезу предложением. Это замечание к статусу, не контрпример. | с. 126–127, заключение", id="node-N2"];
"G4" [label="[И] Рассуждение рецензента\nНезвезда: Δ≤n−2;\n|d(u)²−d(v)²|≤Δ²−1", fillcolor="#EEF1F5", color="#748193", tooltip="Рассуждение рецензента", id="node-G4", shape="ellipse", fontsize="11"];
{rank=same; "G4"; "G1"; "G0";}
{rank=same; "N2"; "G2"; "G3";}
"G4" -> "N2" [style=invis, weight=25];
}
subgraph cluster_metrics {
