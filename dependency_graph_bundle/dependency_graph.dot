"M1" [label="[0] Предл. 3.8.9\nСдвиг 2-липшицев\nв метрике d_SL\nс. 98", fillcolor="#E7F2E9", color="#338153", tooltip="Предл. 3.8.9 | с. 98", id="node-M1"];
}
