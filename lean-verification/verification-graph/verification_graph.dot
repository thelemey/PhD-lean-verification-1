"pro1defnewwordn2" [id="node-pro1defnewwordn2", label=<<FONT POINT-SIZE="9">Предложение 3.5.4</FONT><BR/><B>Длина qₘ и числа букв</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-pro1defnewwordn2", tooltip="Предложение 3.5.4. Длина qₘ и числа букв. Доказано. "];
"thm1Asymptotic" [id="node-thm1asymptotic", label=<<FONT POINT-SIZE="9">Теорема 3.5.5 · Новизна 3</FONT><BR/><B>Точные плотности обрамлённых<BR/>слов и скорость сходимости</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-thm1asymptotic", tooltip="Теорема 3.5.5. Точные плотности обрамлённых слов и скорость сходимости. Доказано. Проверены точные плотности, знак погрешности, пределы и обе скорости из thm1Asymptotic."];
"unframed-error" [id="node-unframed-error", label=<<FONT POINT-SIZE="9">Следствие в тексте</FONT><BR/><B>Знак и скорость погрешности без<BR/>обрамления</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-unframed-error", tooltip="Следствие в тексте. Знак и скорость погрешности без обрамления. Доказано. "];
"tab002densitiesASm" [id="node-tab002densitiesasm", label=<<FONT POINT-SIZE="9">Таблица · Новизна 3</FONT><BR/><B>Числовая таблица плотностей и<BR/>предельная строка</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-tab002densitiesasm", tooltip="Таблица. Числовая таблица плотностей и предельная строка. Доказано. "];
"lem:telesc" [id="node-lem-telesc", label=<<FONT POINT-SIZE="9">Лемма 3.5.3</FONT><BR/><B>Телескопическая разность<BR/>отношений Фибоначчи</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-telesc", tooltip="Лемма 3.5.3. Телескопическая разность отношений Фибоначчи. Доказано. "];
"cassini" [id="node-cassini", label=<<FONT POINT-SIZE="9">Классическое тождество</FONT><BR/><B>Тождество Кассини для чисел<BR/>Фибоначчи</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-cassini", tooltip="Классическое тождество. Тождество Кассини для чисел Фибоначчи. Доказано. "];
"thm:millin" [id="node-thm-millin", label=<<FONT POINT-SIZE="9">Теорема 3.5.6 · Новизна 5</FONT><BR/><B>Ряд Миллина, частичная сумма и<BR/>остаток</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-thm-millin", tooltip="Теорема 3.5.6. Ряд Миллина, частичная сумма и остаток. Доказано. "];
"lem:docagne" [id="node-lem-docagne", label=<<FONT POINT-SIZE="9">Лемма 3.5.4</FONT><BR/><B>Тождество д’Оканя и разность<BR/>отношений</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-docagne", tooltip="Лемма 3.5.4. Тождество д’Оканя и разность отношений. Доказано. "];
"binet" [id="node-binet", label=<<FONT POINT-SIZE="9">Классическое тождество</FONT><BR/><B>Формула Бине для обычных чисел<BR/>Фибоначчи</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-binet", tooltip="Классическое тождество. Формула Бине для обычных чисел Фибоначчи. Доказано. "];
"prop:symm" [id="node-prop-symm", label=<<FONT POINT-SIZE="9">Предложение 3.5.7 · Новизна 5</FONT><BR/><B>Симметрия двух конечных сумм</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-symm", tooltip="Предложение 3.5.7. Симметрия двух конечных сумм. Доказано. "];
"prop:sum2r" [id="node-prop-sum2r", label=<<FONT POINT-SIZE="9">Предложение 3.5.8 · Новизна 5</FONT><BR/><B>Ряд Фибоначчи с чётным сдвигом</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-sum2r", tooltip="Предложение 3.5.8. Ряд Фибоначчи с чётным сдвигом. Доказано. "];
