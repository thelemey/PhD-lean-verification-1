subgraph "cluster_3.6" {
graph [label="§ 3.6", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"eqqintron1" [id="node-eqqintron1", label=<<FONT POINT-SIZE="9">Определение</FONT><BR/><B>Палиндромная плотность через<BR/>limsup длин префиксов</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-eqqintron1", tooltip="Определение. Палиндромная плотность через limsup длин префиксов. Определено. "];
"deffSturmiann1" [id="node-deffsturmiann1", label=<<FONT POINT-SIZE="9">Определение 3.6.1</FONT><BR/><B>Механическое задание<BR/>характеристического слова</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-deffsturmiann1", tooltip="Определение 3.6.1. Механическое задание характеристического слова. Определено. "];
"proirrationaln1" [id="node-proirrationaln1", label=<<FONT POINT-SIZE="9">Предложение 3.6.1</FONT><BR/><B>Стандартные слова сходятся к<BR/>характеристическому</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-proirrationaln1", tooltip="Предложение 3.6.1. Стандартные слова сходятся к характеристическому. Доказано. Для каждого иррационального наклона доказано совпадение предела стандартных слов с нижним механическим словом при сдвиге, равном наклону. Частные берутся из цепной дроби числа. При первом частном 1 вложенность рассматривается с положительных стадий."];
"ThmplinDENSN1" [id="node-thmplindensn1", label=<<FONT POINT-SIZE="9">Теорема 3.6.2</FONT><BR/><B>Оценка Фишлера для любого<BR/>непериодического слова</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-thmplindensn1", tooltip="Теорема 3.6.2. Оценка Фишлера для любого непериодического слова. Доказано. Общая оценка Фишлера доказана для любого непериодического слова. Перекрытие трёх префиксов при плотности выше 1/φ вынуждает постоянный положительный период."];
"lem:palFib" [id="node-lem-palfib", label=<<FONT POINT-SIZE="9">Лемма 3.6.1</FONT><BR/><B>Центральные слова — палиндромные<BR/>префиксы</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-palfib", tooltip="Лемма 3.6.1. Центральные слова — палиндромные префиксы. Доказано. Лемма даёт наличие префиксов указанных длин."];
"fib-pal-complete" [id="node-fib-pal-complete", label=<<FONT POINT-SIZE="9">Цитируемый результат</FONT><BR/><B>Полнота списка длин Fₙ₊₂−2</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-fib-pal-complete", tooltip="Цитируемый результат. Полнота списка длин Fₙ₊₂−2. Доказано. "];
"thm:palFib" [id="node-thm-palfib", label=<<FONT POINT-SIZE="9">Теорема 3.6.3</FONT><BR/><B>Палиндромная плотность слова<BR/>Фибоначчи равна 1/φ</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-thm-palfib", tooltip="Теорема 3.6.3. Палиндромная плотность слова Фибоначчи равна 1/φ. Доказано. Нижняя оценка получена из явных центральных префиксов, верхняя — из общей теоремы Фишлера и непериодичности слова, как в TeX."];
"ternary-word" [id="node-ternary-word", label=<<FONT POINT-SIZE="9">Определение</FONT><BR/><B>Рекурсия y₀ = 01, y₁ = 02</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-ternary-word", tooltip="Определение. Рекурсия y₀ = 01, y₁ = 02. Определено. "];
"lemmanovelwordn1" [id="node-lemmanovelwordn1", label=<<FONT POINT-SIZE="9">Предложение 3.6.4</FONT><BR/><B>Длина и три счётчика букв<BR/>конечного yₙ</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lemmanovelwordn1", tooltip="Предложение 3.6.4. Длина и три счётчика букв конечного yₙ. Доказано. Три счётчика и длина доказаны по конкатенации и двум начальным словам, включая F₋₁ = 1. Проверен предел отношения длин."];
"eq1densityn1" [id="node-eq1densityn1", label=<<FONT POINT-SIZE="9">Следствие 3.6.5</FONT><BR/><B>Три плотности в конечных словах<BR/>yₙ и их пределы</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-eq1densityn1", tooltip="Следствие 3.6.5. Три плотности в конечных словах yₙ и их пределы. Доказано. Доказаны все три конечные частоты и пределы частот букв 1 и 2."];
"lem:Ystructure" [id="node-lem-ystructure", label=<<FONT POINT-SIZE="9">Лемма 3.6.2</FONT><BR/><B>Вложенность yₙ при n ≥ 1 и<BR/>кодирование предела</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-ystructure", tooltip="Лемма 3.6.2. Вложенность yₙ при n ≥ 1 и кодирование предела. Доказано. Проверены кодирование конечных слов и равенство бесконечных слов. Вложенность начинается с n = 1, а y₀ не является префиксом y₁."];
"thm:Yinf" [id="node-thm-yinf", label=<<FONT POINT-SIZE="9">Теорема 3.6.6</FONT><BR/><B>Три предельные плотности букв<BR/>бесконечного слова y</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-thm-yinf", tooltip="Теорема 3.6.6. Три предельные плотности букв бесконечного слова y. Без проверки Lean. "];
"lem:interleave" [id="node-lem-interleave", label=<<FONT POINT-SIZE="9">Лемма 3.6.3</FONT><BR/><B>Длины префиксов после вставки<BR/>разделителя</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-interleave", tooltip="Лемма 3.6.3. Длины префиксов после вставки разделителя. Доказано. Получено точное соответствие длин m ↦ 2m+1 и исключены положительные чётные длины."];
"prop:insertion" [id="node-prop-insertion", label=<<FONT POINT-SIZE="9">Предложение 3.6.7 · Новизна 4 · Защита 2</FONT><BR/><B>Вставка разделителя сохраняет<BR/>палиндромную плотность</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-insertion", tooltip="Предложение 3.6.7. Вставка разделителя сохраняет палиндромную плотность. Доказано. Доказано равенство вещественных палиндромных плотностей после вставки, включая случай конечного числа префиксов."];
"thm:Ypal" [id="node-thm-ypal", label=<<FONT POINT-SIZE="9">Теорема 3.6.8</FONT><BR/><B>Длины 2Fₖ−3 и палиндромная<BR/>плотность слова y</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-thm-ypal", tooltip="Теорема 3.6.8. Длины 2Fₖ−3 и палиндромная плотность слова y. Доказано. Проверены полный список длин 2Fₖ−3 и плотность 1/φ для трёхбуквенного слова по соответствию префиксов и инвариантности при вставке."];
"prop:mk" [id="node-prop-mk", label=<<FONT POINT-SIZE="9">Предложение 3.6.9</FONT><BR/><B>Счётчики букв центральных<BR/>префиксов y и их усечений</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-prop-mk", tooltip="Предложение 3.6.9. Счётчики букв центральных префиксов y и их усечений. Без проверки Lean. "];
"rich-heredity" [id="node-rich-heredity", label=<<FONT POINT-SIZE="9">Цитируемый результат</FONT><BR/><B>Каждый фактор богатого слова<BR/>богат</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-rich-heredity", tooltip="Цитируемый результат. Каждый фактор богатого слова богат. Доказано. "];
"lem:insertcount" [id="node-lem-insertcount", label=<<FONT POINT-SIZE="9">Лемма 3.6.4</FONT><BR/><B>Вставка разделителей даёт 2P+1<BR/>палиндромов</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-insertcount", tooltip="Лемма 3.6.4. Вставка разделителей даёт 2P+1 палиндромов. Доказано. Проверено соответствие палиндромных факторов и формула 2P+1 для числа палиндромов при вставке с двумя граничными разделителями."];
"thm:Yrich" [id="node-thm-yrich", label=<<FONT POINT-SIZE="9">Теорема 3.6.10 · Новизна 4 · Защита 2</FONT><BR/><B>Богатство всех yₙ и каждого<BR/>фактора предела</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-thm-yrich", tooltip="Теорема 3.6.10. Богатство всех yₙ и каждого фактора предела. Доказано. Для y₀ перечислены два односимвольных палиндрома. При n ≥ 1 проверен авторский переход от общего богатства штурмовых факторов через переименование префикса Фибоначчи, обрамление и наследование богатства. Все факторы предела богаты."];
"sturmian-rich" [id="node-sturmian-rich", label=<<FONT POINT-SIZE="9">Цитируемый результат</FONT><BR/><B>Богатство конечных факторов<BR/>штурмовых слов</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-sturmian-rich", tooltip="Цитируемый результат. Богатство конечных факторов штурмовых слов. Доказано. Богатство всех конечных факторов доказано для обеих механических форм из определения §3.6, при любом иррациональном наклоне и любом сдвиге."];
"rich-interleave" [id="node-rich-interleave", label=<<FONT POINT-SIZE="9">Следствие 3.6.11</FONT><BR/><B>Богатство бесконечного слова<BR/>сохраняется при вставке</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-rich-interleave", tooltip="Следствие 3.6.11. Богатство бесконечного слова сохраняется при вставке. Доказано. Доказано для любого богатого бесконечного слова и любого алфавита с новым разделителем."];
"ct:palprefSturm" [id="node-ct-palprefsturm", label=<<FONT POINT-SIZE="9">Теорема 3.6.12</FONT><BR/><B>Все палиндромные префиксы по<BR/>континуантам</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-ct-palprefsturm", tooltip="Теорема 3.6.12. Все палиндромные префиксы по континуантам. Доказано. "];
"thm:palSturm" [id="node-thm-palsturm", label=<<FONT POINT-SIZE="9">Теорема 3.6.13</FONT><BR/><B>Формула Фишлера для<BR/>характеристического слова</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-thm-palsturm", tooltip="Теорема 3.6.13. Формула Фишлера для характеристического слова. Доказано. "];
"prop:dichotomy" [id="node-prop-dichotomy", label=<<FONT POINT-SIZE="9">Предложение 3.6.14 · Новизна 4 · Защита 2</FONT><BR/><B>Дихотомия плотности и плохая<BR/>приближаемость</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-dichotomy", tooltip="Предложение 3.6.14. Дихотомия плотности и плохая приближаемость. Доказано. "];
"cor:palSturm" [id="node-cor-palsturm", label=<<FONT POINT-SIZE="9">Следствие 3.6.15 · Новизна 4 · Защита 2</FONT><BR/><B>Границы, спектр, мера и явные<BR/>значения плотности</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-cor-palsturm", tooltip="Следствие 3.6.15. Границы, спектр, мера и явные значения плотности. Доказано. Проверены все шесть пунктов. Верхняя граница в (1) использует общую теорему Фишлера для непериодических слов. Для (4) доказаны критерий максимума и следующий спектральный порог в характеристическом классе."];
"metric-bad" [id="node-metric-bad", label=<<FONT POINT-SIZE="9">Хинчин и Ярник</FONT><BR/><B>Нулевая мера и размерность 1<BR/>множества Bad</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-metric-bad", tooltip="Хинчин и Ярник. Нулевая мера и размерность 1 множества Bad. Доказано. "];
"sturmian-spectrum" [id="node-sturmian-spectrum", label=<<FONT POINT-SIZE="9">Спектр Фишлера</FONT><BR/><B>Критерий максимума и разрыв в<BR/>спектре плотностей</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-sturmian-spectrum", tooltip="Спектр Фишлера. Критерий максимума и разрыв в спектре плотностей. Доказано. "];
"prop:mbonacci" [id="node-prop-mbonacci", label=<<FONT POINT-SIZE="9">Предложение 3.6.16 · Новизна 4 · Защита 2</FONT><BR/><B>Палиндромная плотность m-боначчи<BR/>равна 1/βₘ</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-mbonacci", tooltip="Предложение 3.6.16. Палиндромная плотность m-боначчи равна 1/βₘ. Доказано. "];
"mbonacci-prefixes" [id="node-mbonacci-prefixes", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Рекурсия длин при циклической<BR/>директиве</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-mbonacci-prefixes", tooltip="Шаг доказательства. Рекурсия длин при циклической директиве. Доказано. "];
}
subgraph "cluster_3.7" {
graph [label="§ 3.7", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"sec:dSL" [id="node-sec-dsl", label=<<FONT POINT-SIZE="9">Определение 3.7.1</FONT><BR/><B>Символико-решёточная метрика на<BR/>A^ℤ</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-sec-dsl", tooltip="Определение 3.7.1. Символико-решёточная метрика на A^ℤ. Определено. "];
"propositionn1" [id="node-propositionn1", label=<<FONT POINT-SIZE="9">Предложение 3.7.1 · Новизна 5</FONT><BR/><B>Топология произведения,<BR/>компактность и оценка для Φ</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-propositionn1", tooltip="Предложение 3.7.1. Топология произведения, компактность и оценка для Φ. Доказано. Для замкнутых подсдвигов доказаны метрические свойства, согласованность с топологией произведения, компактность, полнота и липшицева оценка для отображения."];
}
subgraph "cluster_3.8" {
graph [label="§ 3.8", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"def:strong_repetition" [id="node-def-strong-repetition", label=<<FONT POINT-SIZE="9">Определение 3.8.2</FONT><BR/><B>Сильный (k,δ)-повтор</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-def-strong-repetition", tooltip="Определение 3.8.2. Сильный (k,δ)-повтор. Определено. "];
"def:psiAsigma" [id="node-def-psiasigma", label=<<FONT POINT-SIZE="9">Определение 3.8.3</FONT><BR/><B>Подстановка циклического сдвига</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-def-psiasigma", tooltip="Определение 3.8.3. Подстановка циклического сдвига. Определено. "];
"prop:gTM" [id="node-prop-gtm", label=<<FONT POINT-SIZE="9">Предложение 3.8.1 · Новизна 1</FONT><BR/><B>Двоичная сумма цифр задаёт<BR/>неподвижное слово</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-gtm", tooltip="Предложение 3.8.1. Двоичная сумма цифр задаёт неподвижное слово. Доказано. Доказана формула цифр и соответствие конечных итераций подстановки префиксам неподвижного слова."];
"lem:arith" [id="node-lem-arith", label=<<FONT POINT-SIZE="9">Лемма 3.8.1</FONT><BR/><B>Куб как сравнение на окне длины<BR/>2m</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-arith", tooltip="Лемма 3.8.1. Куб как сравнение на окне длины 2m. Доказано. "];
"lem:half" [id="node-lem-half", label=<<FONT POINT-SIZE="9">Лемма 3.8.2</FONT><BR/><B>Чётные индексы и разность<BR/>соседних переносов</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-half", tooltip="Лемма 3.8.2. Чётные индексы и разность соседних переносов. Доказано. "];
"lem:odd" [id="node-lem-odd", label=<<FONT POINT-SIZE="9">Лемма 3.8.3</FONT><BR/><B>Нечётная длина блока вынуждает m<BR/>= 1 и j ≡ 1</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-odd", tooltip="Лемма 3.8.3. Нечётная длина блока вынуждает m = 1 и j ≡ 1. Доказано. "];
"avoidance" [id="node-avoidance", label=<<FONT POINT-SIZE="9">Теорема 3.8.2 · Новизна 1 · Защита 1</FONT><BR/><B>Двоичный критерий избегания<BR/>скрученного куба</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-avoidance", tooltip="Теорема 3.8.2. Двоичный критерий избегания скрученного куба. Доказано. Бинарный критерий доказан на исходном алфавите для любого целого показателя перестановки. Использованы сведение к нечётному блоку и свидетель с началом 2^N−2 из TeX."];
"complexity-observation" [id="node-complexity-observation", label=<<FONT POINT-SIZE="9">Наблюдение 3.8.3</FONT><BR/><B>Числа факторов при N = 2, 3, 4 и<BR/>k ≤ 40</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-complexity-observation", tooltip="Наблюдение 3.8.3. Числа факторов при N = 2, 3, 4 и k ≤ 40. Без проверки Lean. В TeX указаны разности p(k+1)−p(k) и пример p(40)=303. Перебор для всего указанного диапазона в Lean не проверен."];
"tromp-shallit" [id="node-tromp-shallit", label=<<FONT POINT-SIZE="9">Тромп и Шаллит</FONT><BR/><B>Полная функция сложности s₂(n)<BR/>mod N</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-tromp-shallit", tooltip="Тромп и Шаллит. Полная функция сложности s₂(n) mod N. Без проверки Lean. "];
"complexity-comparison" [id="node-complexity-comparison", label=<<FONT POINT-SIZE="9">Сопоставление</FONT><BR/><B>Наблюдаемые значения как<BR/>иллюстрация формулы Тромпа и<BR/>Шаллита</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-complexity-comparison", tooltip="Сопоставление. Наблюдаемые значения как иллюстрация формулы Тромпа и Шаллита. Без проверки Lean. В исправленной редакции конечный расчёт сопоставлен с известной полной функцией сложности."];
"base-substitution" [id="node-base-substitution", label=<<FONT POINT-SIZE="9">Определение</FONT><BR/><B>Подстановка ξ_b постоянной длины<BR/>b</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-base-substitution", tooltip="Определение. Подстановка ξ_b постоянной длины b. Определено. "];
"tw:gTM" [id="node-tw-gtm", label=<<FONT POINT-SIZE="9">Предложение 3.8.4</FONT><BR/><B>Сумма цифр s_b(n) задаёт слово<BR/>W⁽ᵇ⁾</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-tw-gtm", tooltip="Предложение 3.8.4. Сумма цифр s_b(n) задаёт слово W⁽ᵇ⁾. Доказано. Доказана формула цифр и соответствие конечных итераций подстановки префиксам неподвижного слова."];
"tw:lem" [id="node-tw-lem", label=<<FONT POINT-SIZE="9">Лемма 3.8.4</FONT><BR/><B>Критерий окна, масштабирование и<BR/>переносы в основании b</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-tw-lem", tooltip="Лемма 3.8.4. Критерий окна, масштабирование и переносы в основании b. Доказано. Проверены сравнение соседних блоков, формула прибавления единицы, масштабирование и оба случая переноса через показатель делимости для любого целого основания b ≥ 2."];
"tw:main" [id="node-tw-main", label=<<FONT POINT-SIZE="9">Теорема 3.8.5 · Новизна 1 · Защита 1</FONT><BR/><B>Периодический случай и точный<BR/>порог κ(N,b,j)</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-tw-main", tooltip="Теорема 3.8.5. Периодический случай и точный порог κ(N,b,j). Доказано. Доказаны оба случая из исправленного TeX. В непериодическом случае использованы прореживание окна, период переносов N/gcd(N,b−1) и оба свидетеля существования из доказательства. При j' ≥ b частное не превосходит 2."];
"tw:cor" [id="node-tw-cor", label=<<FONT POINT-SIZE="9">Следствие 3.8.6</FONT><BR/><B>Отсутствие финального периода и<BR/>двоичные пороги 2 и 4</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-tw-cor", tooltip="Следствие 3.8.6. Отсутствие финального периода и двоичные пороги 2 и 4. Доказано. Проверены отсутствие финального периода и бинарные частные случаи через явный порог 2 или 4."];
"eq:blocks" [id="node-eq-blocks", label=<<FONT POINT-SIZE="9">Формула</FONT><BR/><B>Слово разбивается на выровненные<BR/>блоки подстановки</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-eq-blocks", tooltip="Формула. Слово разбивается на выровненные блоки подстановки. Доказано. "];
"thm:dynWb" [id="node-thm-dynwb", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 · Новизна 1 · Защита 1</FONT><BR/><B>Динамика при N ∤ (b−1):<BR/>минимальность, энтропия,<BR/>частоты, строгая эргодичность</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-thm-dynwb", tooltip="Теорема 3.8.7. Динамика при N ∤ (b−1): минимальность, энтропия, частоты, строгая эргодичность. Доказано. Теорема Lean объединяет все пять пунктов для одностороннего замыкания орбиты."];
"dyn-primitive" [id="node-dyn-primitive", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 (1)</FONT><BR/><B>Примитивность подстановки с<BR/>порогом N−1</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-dyn-primitive", tooltip="Теорема 3.8.7 (1). Примитивность подстановки с порогом N−1. Доказано. "];
"dyn-minimal" [id="node-dyn-minimal", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 (2)</FONT><BR/><B>Равномерная рекуррентность и<BR/>минимальность</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-dyn-minimal", tooltip="Теорема 3.8.7 (2). Равномерная рекуррентность и минимальность. Доказано. "];
"dyn-entropy" [id="node-dyn-entropy", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 (3)</FONT><BR/><B>Границы сложности и нулевая<BR/>энтропия</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-dyn-entropy", tooltip="Теорема 3.8.7 (3). Границы сложности и нулевая энтропия. Доказано. "];
"dyn-letters" [id="node-dyn-letters", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 (4)</FONT><BR/><B>Равномерная частота 1/N каждой<BR/>буквы</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-dyn-letters", tooltip="Теорема 3.8.7 (4). Равномерная частота 1/N каждой буквы. Доказано. "];
"dyn-ergodic" [id="node-dyn-ergodic", label=<<FONT POINT-SIZE="9">Теорема 3.8.7 (5)</FONT><BR/><B>Строгая эргодичность и частоты<BR/>факторов</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-dyn-ergodic", tooltip="Теорема 3.8.7 (5). Строгая эргодичность и частоты факторов. Доказано. "];
"morse-hedlund" [id="node-morse-hedlund", label=<<FONT POINT-SIZE="9">Морс и Хедлунд</FONT><BR/><B>Непериодичность даёт p(k) ≥ k+1</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-morse-hedlund", tooltip="Морс и Хедлунд. Непериодичность даёт p(k) ≥ k+1. Доказано. "];
"michel" [id="node-michel", label=<<FONT POINT-SIZE="9">Теорема Мишеля</FONT><BR/><B>Единственность меры для<BR/>примитивной подстановки<BR/>постоянной длины</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-michel", tooltip="Теорема Мишеля. Единственность меры для примитивной подстановки постоянной длины. Доказано. "];
"subshift-avoidance" [id="node-subshift-avoidance", label=<<FONT POINT-SIZE="9">Следствие 3.8.8</FONT><BR/><B>Исключение длинных повторов во<BR/>всём подсдвиге</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-subshift-avoidance", tooltip="Следствие 3.8.8. Исключение длинных повторов во всём подсдвиге. Доказано. Запрет перенесён на всё замыкание орбиты по равенству языков факторов."];
"prop:dSLshift" [id="node-prop-dslshift", label=<<FONT POINT-SIZE="9">Предложение 3.8.9 · Новизна 5</FONT><BR/><B>Сдвиг 2-липшицев в метрике d_SL</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-prop-dslshift", tooltip="Предложение 3.8.9. Сдвиг 2-липшицев в метрике d_SL. Доказано. Доказана липшицевость сдвига с константой 2."];
}
subgraph "cluster_4.2" {
graph [label="§ 4.2", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"cut-model" [id="node-cut-model", label=<<FONT POINT-SIZE="9">Определение</FONT><BR/><B>Полные линии разреза и<BR/>внутренние рёбра</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-cut-model", tooltip="Определение. Полные линии разреза и внутренние рёбра. Определено. Задана геометрическая модель полного удаления линий из объединения квадратов."];
"thm:min-dissection-path" [id="node-thm-min-dissection-path", label=<<FONT POINT-SIZE="9">Теорема 4.2.1 · Новизна 5</FONT><BR/><B>Минимум разрезов равен λ(P),<BR/>включая прямоугольники</B><BR/><FONT POINT-SIZE="9">С уточнением</FONT>>, color="#A68812", fillcolor="#FFEB80", URL="coverage.md#node-thm-min-dissection-path", tooltip="Теорема 4.2.1. Минимум разрезов равен λ(P), включая прямоугольники. С уточнением. Формула доказана при связности по сторонам. Доказано, что это равносильно связности внутренности непустой фигуры. Для произвольного объединения дан конечный критерий: каждая общая сторона разрезана и через каждое диагональное касание проходит хотя бы одна выбранная линия. У двух квадратов, соприкасающихся только углами, λ=0, а минимум равен 1. Буквальное определение из §4.2 допускает этот пример."];
"unit-edge-remark" [id="node-unit-edge-remark", label=<<FONT POINT-SIZE="9">Замечание</FONT><BR/><B>По одному внутреннему ребру за<BR/>раз: минимум и критерий дерева</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-unit-edge-remark", tooltip="Замечание. По одному внутреннему ребру за раз: минимум и критерий дерева. Доказано. Для непустой фигуры, связной по сторонам, доказан критерий N−1. Квадрат 2×2 требует четырёх единичных разрезов или двух полных линий."];
"ex1" [id="node-ex1", label=<<FONT POINT-SIZE="9">Пример</FONT><BR/><B>Домино: один полный разрез</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-ex1", tooltip="Пример. Домино: один полный разрез. Доказано. "];
"ex2" [id="node-ex2", label=<<FONT POINT-SIZE="9">Пример</FONT><BR/><B>L-тримино: две линии и<BR/>промежуточные части</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-ex2", tooltip="Пример. L-тримино: две линии и промежуточные части. Доказано. "];
}
subgraph "cluster_4.3" {
graph [label="§ 4.3", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"tab:descriptive" [id="node-tab-descriptive", label=<<FONT POINT-SIZE="9">Таблица</FONT><BR/><B>Исходные сводки по двум группам<BR/>и двум тестам</B><BR/><FONT POINT-SIZE="9">Частично</FONT>>, color="#D3791A", URL="coverage.md#node-tab-descriptive", tooltip="Таблица. Исходные сводки по двум группам и двум тестам. Частично. Для 12-балльного теста из округления средних и стандартных отклонений доказаны точные суммы, суммы квадратов до и после обучения и по два кандидата для сумм квадратов приростов. Исходные наблюдения не опубликованы."];
"study-welch" [id="node-study-welch", label=<<FONT POINT-SIZE="9">Анализ данных</FONT><BR/><B>Нескорректированное сравнение<BR/>итогов по Уэлчу</B><BR/><FONT POINT-SIZE="9">Частично</FONT>>, color="#D3791A", URL="coverage.md#node-study-welch", tooltip="Анализ данных. Нескорректированное сравнение итогов по Уэлчу. Частично. Для теста на мышление из описательной таблицы воспроизведены оба сравнения Уэлча, включая дробные степени свободы, p = 0,035 и 0,101, 95% ДИ и d Коэна. По обоим инструментам проверены решения до и после обучения, два межгрупповых сравнения приростов и четыре парных теста. Ранговые тесты требуют индивидуальных наблюдений. Для шкалы 0–100 из описательных сводок получены p до обучения от 0,02177 до 0,02208, после от 0,00763 до 0,00778, одностороннее округление 0,004 и d = 0,51 и 0,60. Для прироста по тесту на мышление воспроизведены точная разность −2/42, p = 0,95 и 95% ДИ [−1,61; 1,52]. Для прироста на шкале 0–100 из дополнительных опубликованных 0,52 следует p = 0,91."];
"tab:ancova" [id="node-tab-ancova", label=<<FONT POINT-SIZE="9">Таблица</FONT><BR/><B>Разность между группами после<BR/>поправки на исходный уровень</B><BR/><FONT POINT-SIZE="9">Частично</FONT>>, color="#D3791A", URL="coverage.md#node-tab-ancova", tooltip="Таблица. Разность между группами после поправки на исходный уровень. Частично. Для теста на мышление описательная таблица и два парных t дают всю строку ANCOVA, p = 0,61 для взаимодействия группы с исходным баллом и обе корреляции. Для шкалы 0–100 из одной описательной таблицы следуют 6,2158 ≤ B−A ≤ 6,2401 и 0,1081 ≤ p ≤ 0,10995; из опубликованных контраста и ДИ следует p = 0,109 с точностью до 0,001. Для взаимодействия во втором тесте описательные сводки дают p ≥ 0,92. Для проверки распределения остатков нужны исходные наблюдения. Третья цифра не определяется одной описательной таблицей: доказано существование допустимых наборов с округлениями p до 0,108 и 0,110."];
"study-summary" [id="node-study-summary", label=<<FONT POINT-SIZE="9">Эмпирический вывод · Новизна 7</FONT><BR/><B>После поправки на исходный<BR/>уровень различие между группами<BR/>статистически незначимо по обоим<BR/>тестам</B><BR/><FONT POINT-SIZE="9">С уточнением</FONT>>, color="#A68812", fillcolor="#FFEB80", URL="coverage.md#node-study-summary", tooltip="Эмпирический вывод. После поправки на исходный уровень различие между группами статистически незначимо по обоим тестам. С уточнением. Для любых 42 пар наблюдений в каждой группе, согласующихся со сводками, доказаны оба исходных преимущества B, нескорректированное итоговое различие только по числам, близость приростов и оба решения ANCOVA при уровне 0,05. Сами измерения и эмпирические допущения модели по опубликованным таблицам не проверяются."];
}
subgraph "cluster_5.1" {
graph [label="§ 5.1", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"tree-index" [id="node-tree-index", label=<<FONT POINT-SIZE="9">Определение</FONT><BR/><B>Квадратичный индекс как сумма<BR/>|dᵤ²−dᵥ²|</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-tree-index", tooltip="Определение. Квадратичный индекс как сумма |dᵤ²−dᵥ²|. Определено. "];
"pron1" [id="node-pron1", label=<<FONT POINT-SIZE="9">Предложение 5.1.1</FONT><BR/><B>Нижняя граница Δ(Δ²−1) и<BR/>критерий равенства</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-pron1", tooltip="Предложение 5.1.1. Нижняя граница Δ(Δ²−1) и критерий равенства. Доказано. Доказана нижняя оценка суммированием по путям от вершины максимальной степени, строгий случай второй ветвящейся вершины и критерий равенства: путь либо дерево с единственной вершиной степени больше двух."];
"pron2" [id="node-pron2", label=<<FONT POINT-SIZE="9">Предложение 5.1.2</FONT><BR/><B>Путь строго минимизирует<BR/>квадратичный индекс при n ≥ 5</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-pron2", tooltip="Предложение 5.1.2. Путь строго минимизирует квадратичный индекс при n ≥ 5. Доказано. Индекс пути равен 6. Для дерева, отличного от пути, нижняя граница равна как минимум 24."];
"star-maximum" [id="node-star-maximum", label=<<FONT POINT-SIZE="9">Предложение</FONT><BR/><B>Звезда строго максимизирует<BR/>квадратичный индекс</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-star-maximum", tooltip="Предложение. Звезда строго максимизирует квадратичный индекс. Доказано. Для n ≥ 3 индекс звезды равен n(n−1)(n−2) и строго превосходит индекс каждого другого дерева того же порядка."];
"star-bound" [id="node-star-bound", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Верхняя оценка через<BR/>максимальную степень и число<BR/>рёбер</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-star-bound", tooltip="Шаг доказательства. Верхняя оценка через максимальную степень и число рёбер. Доказано. Для незвезды максимальная степень не больше n−2. Вклад ребра не больше Δ²−1, затем оценка суммируется по n−1 рёбрам."];
"lemn01" [id="node-lemn01", label=<<FONT POINT-SIZE="9">Лемма 5.1.1</FONT><BR/><B>Изменение квадратичного индекса<BR/>при добавлении ребра</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-lemn01", tooltip="Лемма 5.1.1. Изменение квадратичного индекса при добавлении ребра. Без проверки Lean. "];
"factor-tree" [id="node-factor-tree", label=<<FONT POINT-SIZE="9">Определение 5.1.1</FONT><BR/><B>Дерево факторов глубины n</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-factor-tree", tooltip="Определение 5.1.1. Дерево факторов глубины n. Определено. "];
"thm:factortree" [id="node-thm-factortree", label=<<FONT POINT-SIZE="9">Теорема 5.1.3 · Новизна 2 · Защита 3</FONT><BR/><B>Число вершин и четыре индекса<BR/>дерева факторов</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-thm-factortree", tooltip="Теорема 5.1.3. Число вершин и четыре индекса дерева факторов. Доказано. Проверены число вершин и все четыре индекса для дерева в SimpleGraph."];
"factor-complexity" [id="node-factor-complexity", label=<<FONT POINT-SIZE="9">Факт F1</FONT><BR/><B>Сложность k+1 и единственность<BR/>специального фактора</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-factor-complexity", tooltip="Факт F1. Сложность k+1 и единственность специального фактора. Доказано. "];
"reversed-prefix" [id="node-reversed-prefix", label=<<FONT POINT-SIZE="9">Факт F2</FONT><BR/><B>Правый специальный фактор есть<BR/>обращение префикса</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-reversed-prefix", tooltip="Факт F2. Правый специальный фактор есть обращение префикса. Доказано. "];
"degree-pairs" [id="node-degree-pairs", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Подсчёт рёбер по парам степеней</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-degree-pairs", tooltip="Шаг доказательства. Подсчёт рёбер по парам степеней. Доказано. "];
"tree-table" [id="node-tree-table", label=<<FONT POINT-SIZE="9">Таблица</FONT><BR/><B>Четыре значения длины первой<BR/>серии при n = 8</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-tree-table", tooltip="Таблица. Четыре значения длины первой серии при n = 8. Доказано. "];
"newfibword" [id="node-newfibword", label=<<FONT POINT-SIZE="9">Определение 5.1.2</FONT><BR/><B>Двумерная рекурсия слов T(u,v)</B><BR/><FONT POINT-SIZE="9">Определено</FONT>>, color="#629740", URL="coverage.md#node-newfibword", tooltip="Определение 5.1.2. Двумерная рекурсия слов T(u,v). Определено. "];
"newprove" [id="node-newprove", label=<<FONT POINT-SIZE="9">Предложение 5.1.4 · Новизна 5</FONT><BR/><B>Биномиальные подсчёты, точные<BR/>плотности и логарифмический<BR/>предел</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-newprove", tooltip="Предложение 5.1.4. Биномиальные подсчёты, точные плотности и логарифмический предел. Доказано. "];
}
