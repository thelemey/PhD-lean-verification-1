"mainre" [id="node-mainre", label=<<FONT POINT-SIZE="9">Теорема 3.4.2</FONT><BR/><B>Точные количества букв и<BR/>оптимальные границы отклонений</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-mainre", tooltip="Теорема 3.4.2. Точные количества букв и оптимальные границы отклонений. Доказано. Телескопирование даёт оба счётчика, плотность иррационального вращения даёт резкость границ."];
"prop:balance" [id="node-prop-balance", label=<<FONT POINT-SIZE="9">Предложение 3.4.3</FONT><BR/><B>Сбалансированность и плотности в<BR/>любом факторе</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-prop-balance", tooltip="Предложение 3.4.3. Сбалансированность и плотности в любом факторе. Доказано. Для каждого окна доказаны формула разности целых частей, два возможных подсчёта каждой буквы и строгие оценки обеих плотностей при положительной длине."];
"pal-complexity" [id="node-pal-complexity", label=<<FONT POINT-SIZE="9">Предложение 3.4.4</FONT><BR/><B>Штурмовость по палиндромной<BR/>сложности каждой длины</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-pal-complexity", tooltip="Предложение 3.4.4. Штурмовость по палиндромной сложности каждой длины. Без проверки Lean. "];
}
