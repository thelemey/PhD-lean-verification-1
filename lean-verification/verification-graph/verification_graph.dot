digraph dependencies {
graph [label="Граф верификации диссертации в Lean\nСохранены узлы и стрелки графа зависимостей\nЦвета и метки в квадратных скобках — экспертная оценка исходной редакции\nСтрока Lean — доказано · с уточнением · частично · определение · без отметки", labelloc=t, rankdir=TB, bgcolor="white", compound=true, pad=0.15, nodesep=0.18, ranksep=0.42, fontname="DejaVu Sans", fontsize=18, splines=polyline, outputorder=edgesfirst, pack=true, packmode="array_3"];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, fontcolor="#17212B", margin="0.14,0.10", penwidth=1.15];
edge [color="#647488", penwidth=1.05, arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
subgraph cluster_factorials {
label="2.2  Конкатенация факториалов"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"E1" [label=<[3] Текст перед леммой 2.2.1<BR/>«log(n!) не равномерно<BR/>распределён mod 1»<BR/>с. 43<BR/><FONT COLOR="#613C88"><B>Lean: С уточнением</B></FONT>>, fillcolor="#FFD5BD", color="#CC5200", tooltip="Lean: С уточнением. Для любого основания b > 1 доказано равномерное распределение дробных частей log_b(n!), то есть исправленная формулировка. | Утверждение неверно. Для любого фиксированного b>1 дробные части log_b(n!) равномерно распределены. В доказательстве леммы 2.2.1 это отрицательное утверждение не используется. | с. 43; строка 924 TeX", id="node-E1", URL="coverage.md#node-e1"];
"F1" [label=<[0] Лемма 2.2.1<BR/>Бесконечно много попаданий<BR/>в каждый интервал mod 1<BR/>с. 43–44<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказаны равномерное распределение и попадания в любой полуинтервал положительной длины за любой заданной границей. | Лемма 2.2.1 | с. 43–44", id="node-F1", URL="coverage.md#node-f1"];
"F2" [label=<[0] Лемма 2.2.2<BR/>Заданный ненулевой префикс<BR/>в записи n!<BR/>с. 44<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Любой допустимый префикс с ненулевой первой цифрой появляется в сколь угодно поздних факториалах. | Лемма 2.2.2 | с. 44", id="node-F2", URL="coverage.md#node-f2"];
"F3" [label=<[0] Лемма 2.2.3<BR/>Произвольно длинный<BR/>концевой блок нулей<BR/>с. 44<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены точная формула через показатели простых, монотонность и стремление числа концевых нулей к бесконечности. | Лемма 2.2.3 | с. 44", id="node-F3", URL="coverage.md#node-f3"];
"F4" [label=<[0] Предл. 2.2.2<BR/>p(k) ≤ a(k) ≤ b^k<BR/>с. 45<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Для произвольного слова над конечным алфавитом доказана цепочка p(k) ≤ a(k) ≤ |A|^k через прогрессии шага один и включение в множество всех слов длины k. | Предл. 2.2.2 | с. 45", id="node-F4", URL="coverage.md#node-f4"];
"F5" [label=<[0] Теорема 2.2.3<BR/>Полная факторная и<BR/>арифметическая сложность<BR/>с. 45–46<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Обе сложности бесконечной конкатенации над Fin b равны b^k. | Теорема 2.2.3 | с. 45–46", id="node-F5", URL="coverage.md#node-f5"];
}
subgraph cluster_prelim {
label="3.1  Ошибки предварительного раздела"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"E2" [label=<[1] Формула (3.4)<BR/>Вторая сумма равна F(n+1),<BR/>а не F(n)<BR/>с. 49<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#FFF3C4", color="#B78300", tooltip="Lean: Без отметки. | При F0=0, F1=1 две напечатанные суммы дают при n=3 значения 2 и 3. Это локальная ошибка индексации. В показанных доказательствах используется отдельная рекурсия / формула Бине. | с. 49; формула (3.4)", id="node-E2", URL="coverage.md#node-e2"];
"E3" [label=<[4] Определение 3.1.2<BR/>При k=3, p=1:<BR/>F₁¹(t,3)=0 и F₁¹(t,3)=1<BR/>с. 49<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#FBC9D0", color="#B51F37", tooltip="Lean: Без отметки. | Начальные условия (3.8) противоречат друг другу. Объект в напечатанном определении не существует для этих разрешённых параметров. Уровень 4 относится к этому определению, а не ко всей диссертации. | с. 49; формулы (3.7), (3.8)", id="node-E3", URL="coverage.md#node-e3"];
"A1" [label=<[2] Лемма 3.1.1<BR/>Производящая функция (3.11)<BR/>для объекта из опр. 3.1.2<BR/>с. 50<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#FFE3AC", color="#C47700", tooltip="Lean: Без отметки. | Формула относится к последовательности из противоречивого определения. До исправления определения утверждение нельзя принимать в текущей форме. Это не самостоятельное доказательство ложности формулы после восстановления правильных условий. | с. 50; формула (3.11)", id="node-A1", URL="coverage.md#node-a1"];
"E4" [label=<[3] Теорема 3.1.1<BR/>(3.13): 2·limsup[…] вместо<BR/>2 + limsup[…] при смысле E*<BR/>с. 50–51<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#FFD5BD", color="#CC5200", tooltip="Lean: Без отметки. | ind и ind* не определены. Если ind* означает асимптотический критический показатель, множитель 2 ошибочен: нужен 2+limsup. Для Фибоначчи получаются 2φ и 2+φ соответственно. Эту формулу последующие показанные доказательства не используют. | с. 50–51; формула (3.13)", id="node-E4", URL="coverage.md#node-e4"];
}
subgraph cluster_fibonacci {
label="3.4–3.5  Буквы, механическое описание, обрамления"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"B0" [label=<[И] Рекурсия слова Фибоначчи<BR/>s₀=0, s₁=01;<BR/>sₙ=sₙ₋₁sₙ₋₂<BR/><FONT COLOR="#174C7B"><B>Lean: Определение</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Определение. Заданы конечные рекурсивные слова и их бесконечный предел. | Фиксированное исходное определение классического слова, использованное в разных частях текста.", id="node-B0", shape="ellipse", fontsize="11", URL="coverage.md#node-b0"];
"B1" [label=<[0] Предл. 3.4.1<BR/>Механическое представление<BR/>букв слова Фибоначчи<BR/>с. 57<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказано равенство рекурсивного слова и характеристического механического слова наклона 1/φ², включая формулу для буквы. Предложение в TeX приведено со ссылкой на Lothaire. | Предл. 3.4.1 | с. 57", id="node-B1", URL="coverage.md#node-b1"];
"B2" [label=<[0] Теорема 3.4.2<BR/>Точный подсчёт букв<BR/>и оптимальное отклонение<BR/>с. 57–58<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Телескопическая сумма даёт оба точных подсчёта. Проверены строгие оценки, недостижимость и оптимальность границ через плотность иррационального вращения, а также оба предела плотностей. В следствии проверены остатки O(1). | Теорема 3.4.2 | с. 57–58", id="node-B2", URL="coverage.md#node-b2"];
"B3" [label=<[0] Предл. 3.4.3<BR/>Сбалансированность<BR/>всех факторов<BR/>с. 59–60<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Для каждого окна доказаны формула разности целых частей, два возможных подсчёта каждой буквы и строгие оценки обеих плотностей при положительной длине. | Предл. 3.4.3 | с. 59–60", id="node-B3", URL="coverage.md#node-b3"];
"B4" [label=<[0] Леммы 3.5.1 → 3.5.2<BR/>Позиции Битти;<BR/>запрет факторов 11 и 000<BR/>с. 66–67<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Обе последовательности позиций получены из механической формулы и теоремы Битти. Из промежутков 2 и 3 между единицами выведены запрещённые блоки и точный список факторов длины три. | Леммы 3.5.1 → 3.5.2 | с. 66–67", id="node-B4", URL="coverage.md#node-b4"];
"B5" [label=<[0] Предл. 3.5.3 → 3.5.4<BR/>Количество букв<BR/>в uₘ и qₘ=a uₘ b<BR/>с. 69<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены длины и оба подсчёта букв для исходных и обрамлённых конечных слов. | Предл. 3.5.3 → 3.5.4 | с. 69", id="node-B5", URL="coverage.md#node-b5"];
"B6" [label=<[0] Лемма 3.1.2<BR/>Тождества Бине<BR/>и предельные отношения<BR/>с. 52<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены тождества Бине и все три предела отношений из lem:fibA. | Лемма 3.1.2 | с. 52", id="node-B6", URL="coverage.md#node-b6"];
"B7" [label=<[0] Теорема 3.5.5<BR/>Точная погрешность плотности<BR/>в обрамлённых словах<BR/>с. 70<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены точные плотности, знак погрешности, пределы и обе скорости из thm1Asymptotic. | Теорема 3.5.5 | с. 70", id="node-B7", URL="coverage.md#node-b7"];
{rank=same; "B0"; "B1"; "B6";}
{rank=same; "B5"; "B2"; "B3"; "B4";}
{rank=same; "B7";}
"B0" -> "B5" [style=invis, weight=25];
"B5" -> "B7" [style=invis, weight=25];
}
subgraph cluster_palindromes {
label="3.6  Палиндромы"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"C1" [label=<[0] Лемма 3.6.1<BR/>Явные палиндромные<BR/>префиксы Фибоначчи<BR/>с. 74–75<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Центральные слова палиндромны и дают указанные длины префиксов. Полнота списка относится к C12. | Лемма 3.6.1 | с. 74–75", id="node-C1", URL="coverage.md#node-c1"];
"C2" [label=<[0] Теорема 3.6.2 (Фишлер)<BR/>densₚ(w) ≤ 1/φ<BR/>для непериодического w<BR/>с. 74<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Без отметки. Узел относится к общей теореме Фишлера для произвольного непериодического слова. В C11 проверена оценка для характеристических штурмовых слов. | Теорема 3.6.2 (Фишлер) | с. 74", id="node-C2", URL="coverage.md#node-c2"];
"C3" [label=<[0] Теорема 3.6.3<BR/>densₚ(f)=1/φ<BR/>с. 75<BR/><FONT COLOR="#613C88"><B>Lean: С уточнением</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: С уточнением. Доказана нижняя оценка плотности из TeX через сравнение с двумя соседними центральными префиксами. Для обратной оценки использован полный список префиксов из замечания TeX. Общая оценка Фишлера из C2 остаётся открытой. | Теорема 3.6.3 | с. 75", id="node-C3", URL="coverage.md#node-c3"];
"C4" [label=<[1] Лемма 3.6.2<BR/>y = ι₀(ρ(f))<BR/>[1: вложенность лишь с n=1]<BR/>с. 77–78<BR/><FONT COLOR="#613C88"><B>Lean: С уточнением</B></FONT>>, fillcolor="#FFF3C4", color="#B78300", tooltip="Lean: С уточнением. Проверены кодирование конечных слов и равенство бесконечных слов. Вложенность начинается с n = 1, а y₀ не является префиксом y₁. | Обнаружена дополнительная граничная неточность: y₀=01 не является префиксом y₁=02. Утверждение о вложенности верно для n≥1. Предельное кодирование y=ι₀(ρ(f)) сохраняется; в доказательстве богатства y₀ нужно рассмотреть отдельно или использовать, что s₋₁=1 является фактором f. | с. 77–78; лемма 3.6.2", id="node-C4", URL="coverage.md#node-c4"];
"C5" [label=<[0] Лемма 3.6.3<BR/>Длины палиндромных<BR/>префиксов: m → 2m+1<BR/>с. 78<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Получено точное соответствие длин m ↦ 2m+1 и исключены положительные чётные длины. | Лемма 3.6.3 | с. 78", id="node-C5", URL="coverage.md#node-c5"];
"C6" [label=<[0] Предл. 3.6.7<BR/>Вставка нуля<BR/>сохраняет densₚ<BR/>с. 78–79<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказано равенство вещественных палиндромных плотностей после вставки, включая случай конечного числа префиксов. | Предл. 3.6.7 | с. 78–79", id="node-C6", URL="coverage.md#node-c6"];
"C7" [label=<[0] Теорема 3.6.8<BR/>Префиксы y: 2Fₖ−3;<BR/>densₚ(y)=1/φ<BR/>с. 79<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены полный список длин 2Fₖ−3 и плотность 1/φ для трёхбуквенного слова по соответствию префиксов и инвариантности при вставке. | Теорема 3.6.8 | с. 79", id="node-C7", URL="coverage.md#node-c7"];
"C8" [label=<[0] Лемма 3.6.4<BR/>Подсчёт палиндромов<BR/>при вставке разделителя<BR/>с. 79–80<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверено соответствие палиндромных факторов и формула 2P+1 для числа палиндромов при вставке с двумя граничными разделителями. | Лемма 3.6.4 | с. 79–80", id="node-C8", URL="coverage.md#node-c8"];
"C9" [label=<[0] Теорема 3.6.10<BR/>Богатство yₙ<BR/>и всех факторов y<BR/>с. 80<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказано богатство каждого конечного yₙ и всех факторов бесконечного y. | Теорема 3.6.10 | с. 80", id="node-C9", URL="coverage.md#node-c9"];
"C10" [label=<[0] Теоремы 3.6.12 → 3.6.13<BR/>Список префиксов;<BR/>формула Фишлера через CF<BR/>с. 81<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены полный список положительных длин по континуантам, включая два начальных блока, и формула Фишлера для характеристического слова. | Теоремы 3.6.12 → 3.6.13 | с. 81", id="node-C10", URL="coverage.md#node-c10"];
"C11" [label=<[0] Предл. 3.6.14; след. 3.6.15<BR/>Дихотомия плотности<BR/>и её следствия<BR/>с. 81–83<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены дихотомия, обе границы, критерий максимума, постоянный хвост, эффект вставки и теоретико-мерные следствия. | Предл. 3.6.14; след. 3.6.15 | с. 81–83", id="node-C11", URL="coverage.md#node-c11"];
"C12" [label=<[И] Классические факты<BR/>Все палиндромные префиксы f;<BR/>богатство штурмовых факторов<BR/><FONT COLOR="#85480C"><B>Lean: Частично</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Частично. Проверены полный список палиндромных префиксов слова Фибоначчи и богатство его конечных факторов. Богатство всех штурмовых факторов в общем случае остаётся открытым для этой формализации. | Полнота списка префиксов берётся из классической литературы, а не из одной леммы 3.6.1.", id="node-C12", shape="ellipse", fontsize="11", URL="coverage.md#node-c12"];
{rank=same; "C1"; "C2"; "C12";}
{rank=same; "C3"; "C4"; "C5";}
{rank=same; "C6"; "C7"; "C8";}
{rank=same; "C9"; "C10";}
{rank=same; "C11";}
"C1" -> "C3" [style=invis, weight=25];
"C3" -> "C6" [style=invis, weight=25];
"C6" -> "C9" [style=invis, weight=25];
"C9" -> "C11" [style=invis, weight=25];
}
subgraph cluster_twisted {
label="3.8  Скрученные повторы и динамика"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"D0" [label=<[0] Предл. 3.8.1 / 3.8.4<BR/>W[n]=s_b(n) mod N<BR/>с. 90–91, 93<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказана формула цифр и соответствие конечных итераций подстановки префиксам неподвижного слова. | Предл. 3.8.1 / 3.8.4 | с. 90–91, 93", id="node-D0", URL="coverage.md#node-d0"];
"D1" [label=<[0] Лемма 3.8.4<BR/>Повторы ↔ постоянство cₘ;<BR/>арифметика переносов<BR/>с. 93–94<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены сравнение соседних блоков, формула прибавления единицы, масштабирование и оба случая переноса через показатель делимости для любого целого основания b ≥ 2. | Лемма 3.8.4 | с. 93–94", id="node-D1", URL="coverage.md#node-d1"];
"D2" [label=<[0] Леммы 3.8.1–3.8.3<BR/>Двоичный случай:<BR/>редукция длины блока<BR/>с. 91–92<BR/><FONT COLOR="#85480C"><B>Lean: Частично</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Частично. Редукция окна и двоичное ограничение входят в доказательство необходимости. Весь пакет отдельных лемм 3.8.1–3.8.3 в исходных формулировках не отмечен. | Леммы 3.8.1–3.8.3 | с. 91–92", id="node-D2", URL="coverage.md#node-d2"];
"D3" [label=<[0] Теорема 3.8.2<BR/>Классификация<BR/>скрученных кубов при b=2<BR/>с. 92<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Бинарный критерий избегания доказан на исходном алфавите для любого целого показателя перестановки. | Теорема 3.8.2 | с. 92", id="node-D3", URL="coverage.md#node-d3"];
"E5" [label=<[1] Теорема 3.8.5<BR/>Полная классификация κ<BR/>[1: поправка в доказательстве]<BR/>с. 94–95<BR/><FONT COLOR="#613C88"><B>Lean: С уточнением</B></FONT>>, fillcolor="#FFF3C4", color="#B78300", tooltip="Lean: С уточнением. Доказаны периодический и непериодический случаи с поправкой из исправленного TeX. При j' ≥ b частное в формуле не превосходит 2. | В конце шага 2 при j'≥b неверно написано floor(2b/j')≤1; нужно ≤2. Значение κ=max{2,floor(2b/j')} и вывод теоремы сохраняются. | с. 94–95; последняя строка доказательства", id="node-E5", URL="coverage.md#node-e5"];
"D4" [label=<[0] Следствие 3.8.6<BR/>Непериодичность;<BR/>частные случаи классификации<BR/>с. 95–96<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены отсутствие финального периода и бинарные частные случаи через явный порог 2 или 4. | Следствие 3.8.6 | с. 95–96", id="node-D4", URL="coverage.md#node-d4"];
"D5" [label=<[0] Теорема 3.8.7 (1,2,4,5)<BR/>Примитивность, минимальность,<BR/>частоты, строгая эргодичность<BR/>с. 96–97<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены пункты (1), (2), (4) и (5) для одностороннего замыкания орбиты. | Теорема 3.8.7 (1,2,4,5) | с. 96–97", id="node-D5", URL="coverage.md#node-d5"];
"D6" [label=<[0] Теорема 3.8.7 (3)<BR/>Непериодичность,<BR/>линейная сложность, h=0<BR/>с. 96–97<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены пункт (3), обе границы сложности при положительной длине и нулевая энтропия. | Теорема 3.8.7 (3) | с. 96–97", id="node-D6", URL="coverage.md#node-d6"];
"D7" [label=<[0] Следствие 3.8.8<BR/>Запрет повторов<BR/>на всём подсдвиге X_W<BR/>с. 97<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Запрет перенесён на всё замыкание орбиты по равенству языков факторов. | Следствие 3.8.8 | с. 97", id="node-D7", URL="coverage.md#node-d7"];
"N1" [label=<[Н] Наблюдение 3.8.3<BR/>Точная закономерность p(n)<BR/>оставлена открытым вопросом<BR/>с. 93, 98, 134<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#E9DDF6", color="#8054A6", tooltip="Lean: Без отметки. | Полная факторная сложность s₂(n) mod N вычислена Tromp–Shallit (1995). Требуется сопоставление с известной формулой; вычислительное наблюдение само по себе не объявляется ложным. | с. 93, 98, 134", id="node-N1", URL="coverage.md#node-n1"];
"D8" [label=<[И] Внешние классические факты<BR/>Примитивные подстановки;<BR/>теорема Морса–Хедлунда<BR/><FONT COLOR="#85480C"><B>Lean: Частично</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Частично. Проверены используемый случай строгой эргодичности для примитивных подстановок постоянной длины и нижняя оценка Морса–Хедлунда. | Внешние классические факты", id="node-D8", shape="ellipse", fontsize="11", URL="coverage.md#node-d8"];
"D9" [label=<[И] Tromp–Shallit, 1995<BR/>Факторная сложность<BR/>s₂(n) mod N<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Без отметки. | Tromp–Shallit, 1995", id="node-D9", shape="ellipse", fontsize="11", URL="coverage.md#node-d9"];
{rank=same; "D9"; "D0"; "D8";}
{rank=same; "N1"; "D1"; "D2";}
{rank=same; "E5"; "D5"; "D3";}
{rank=same; "D4"; "D7";}
{rank=same; "D6";}
"D9" -> "N1" [style=invis, weight=25];
"N1" -> "E5" [style=invis, weight=25];
"E5" -> "D4" [style=invis, weight=25];
"D4" -> "D6" [style=invis, weight=25];
}
subgraph cluster_trees {
label="5.1  Деревья и индексы"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"G0" [label=<[И] Штурмов язык<BR/>p(k)=k+1;<BR/>правый специальный фактор rₖ<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Доказано. Для характеристического слова проверены p(k)=k+1 и идентификация правого специального фактора с обращением префикса. Число специальных факторов следует из разности сложностей. | Штурмов язык", id="node-G0", shape="ellipse", fontsize="11", URL="coverage.md#node-g0"];
"G1" [label=<[0] Предл. 5.1.1<BR/>Нижняя оценка<BR/>irr₂(T) ≥ Δ(Δ²−1)<BR/>с. 126<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Без отметки. | Предл. 5.1.1 | с. 126", id="node-G1", URL="coverage.md#node-g1"];
"G2" [label=<[0] Предл. 5.1.2<BR/>Путь минимизирует irr₂<BR/>с. 126<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Без отметки. | Предл. 5.1.2 | с. 126", id="node-G2", URL="coverage.md#node-g2"];
"G3" [label=<[0] Теорема 5.1.3<BR/>Индексы дерева факторов<BR/>штурмова слова<BR/>с. 128–129<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Проверены число вершин и все четыре индекса для дерева в SimpleGraph. | Теорема 5.1.3 | с. 128–129", id="node-G3", URL="coverage.md#node-g3"];
"N2" [label=<[Н] Гипотеза 1<BR/>Звезда максимизирует irr₂<BR/>[Н: уже есть простое доказательство]<BR/>с. 126–127, заключение<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#E9DDF6", color="#8054A6", tooltip="Lean: Без отметки. | Утверждение истинно: каждое ребро даёт не более Δ²−1, а для незвезды Δ≤n−2. Требуется заменить гипотезу предложением. Это замечание к статусу, не контрпример. | с. 126–127, заключение", id="node-N2", URL="coverage.md#node-n2"];
"G4" [label=<[И] Рассуждение рецензента<BR/>Незвезда: Δ≤n−2;<BR/>|d(u)²−d(v)²|≤Δ²−1<BR/><FONT COLOR="#4A5563"><B>Lean: Без отметки</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Без отметки. | Рассуждение рецензента", id="node-G4", shape="ellipse", fontsize="11", URL="coverage.md#node-g4"];
{rank=same; "G4"; "G1"; "G0";}
{rank=same; "N2"; "G2"; "G3";}
"G4" -> "N2" [style=invis, weight=25];
}
subgraph cluster_metrics {
label="3.7–3.8  Метрика"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"N3" [label=<[Н] Предл. 3.7.1<BR/>Компактность и метрика<BR/>[Н: стандартная конструкция]<BR/>с. 88–89<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E9DDF6", color="#8054A6", tooltip="Lean: Доказано. Для замкнутых подсдвигов доказаны метрические свойства, согласованность с топологией произведения, компактность, полнота и липшицева оценка для отображения. | Неверного утверждения не установлено. Суммируемая взвешенная метрика конечного произведения и компактность стандартны; самостоятельный новый результат не обоснован. | с. 88–89", id="node-N3", URL="coverage.md#node-n3"];
"M1" [label=<[0] Предл. 3.8.9<BR/>Сдвиг 2-липшицев<BR/>в метрике d_SL<BR/>с. 98<BR/><FONT COLOR="#065F46"><B>Lean: Доказано</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: Доказано. Доказана липшицевость сдвига с константой 2. | Предл. 3.8.9 | с. 98", id="node-M1", URL="coverage.md#node-m1"];
}
subgraph cluster_polyomino {
label="4.2  Разрезание полимино"; labelloc=t; labeljust=l; color="#C8D1DA"; style="rounded"; penwidth=0.8; margin=14;
"Q0" [label=<[И] Модель разрезания<BR/>Полные линии сетки;<BR/>без перемещения частей<BR/><FONT COLOR="#174C7B"><B>Lean: Определение</B></FONT>>, fillcolor="#EEF1F5", color="#748193", tooltip="Lean: Определение. Задана геометрическая модель полного удаления линий из объединения квадратов. | Модель разрезания", id="node-Q0", shape="ellipse", fontsize="11", URL="coverage.md#node-q0"];
"Q1" [label=<[0] Теорема 4.2.1<BR/>Минимум разрезов = λ(P)<BR/>с. 107–108<BR/><FONT COLOR="#613C88"><B>Lean: С уточнением</B></FONT>>, fillcolor="#E7F2E9", color="#338153", tooltip="Lean: С уточнением. Формула доказана для полимино, связного по общим сторонам, включая прямоугольник. Для касания только в вершине проверен контрпример. | Теорема 4.2.1 | с. 107–108", id="node-Q1", URL="coverage.md#node-q1"];
}
