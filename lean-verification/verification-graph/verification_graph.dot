digraph corrected_thesis {
graph [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6"><TR><TD COLSPAN="5"><FONT POINT-SIZE="19"><B>Зависимости утверждений и проверка в Lean</B></FONT></TD></TR><TR><TD COLSPAN="5">Исправленная диссертация · стрелка ведёт от предпосылки к результату</TD></TR><TR><TD BORDER="3" COLOR="#228044" CELLPADDING="5">Доказано</TD><TD BORDER="3" COLOR="#629740" CELLPADDING="5">Определено</TD><TD BORDER="3" COLOR="#A68812" CELLPADDING="5">С уточнением</TD><TD BORDER="3" COLOR="#D3791A" CELLPADDING="5">Частично</TD><TD BORDER="3" COLOR="#C43735" CELLPADDING="5">Без проверки Lean</TD></TR><TR><TD COLSPAN="5" BGCOLOR="#FFEB80" CELLPADDING="4">Жёлтый фон — научная новизна или положение, вынесенное на защиту</TD></TR></TABLE>>, labelloc=t, bgcolor="white", pad=0.28, rankdir=LR, pack=true, packmode="array3", nodesep=0.24, ranksep=0.46, fontname="DejaVu Sans", fontsize=10];
node [shape=box, style="rounded,filled", fillcolor="white", penwidth=3, margin="0.12,0.08", fontname="DejaVu Sans", fontsize=11, fontcolor="#202A32"];
edge [color="#72818B", arrowsize=0.65];
subgraph "cluster_2.1" {
graph [label="§ 2.1", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"pro.5.3" [id="node-pro-5-3", label=<<FONT POINT-SIZE="9">Предложение 2.1.1</FONT><BR/><B>Число палиндромных факторов не<BR/>превосходит длину</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-pro-5-3", tooltip="Предложение 2.1.1. Число палиндромных факторов не превосходит длину. Доказано. "];
"mahalingam-bounds" [id="node-mahalingam-bounds", label=<<FONT POINT-SIZE="9">Предложение 2.1.2</FONT><BR/><B>Оценки P(w) ≤ |w| ≤ SP(w)</B><BR/><FONT POINT-SIZE="9">Частично</FONT>>, color="#D3791A", URL="coverage.md#node-mahalingam-bounds", tooltip="Предложение 2.1.2. Оценки P(w) ≤ |w| ≤ SP(w). Частично. Проверена левая оценка. Для числа рассеянных палиндромов свидетельство в проекте отсутствует."];
"lem:pal_subset_spal" [id="node-lem-pal-subset-spal", label=<<FONT POINT-SIZE="9">Лемма 2.1.1</FONT><BR/><B>Включение факторов в рассеянные<BR/>палиндромы</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-lem-pal-subset-spal", tooltip="Лемма 2.1.1. Включение факторов в рассеянные палиндромы. Без проверки Lean. "];
"pal_spal" [id="node-pal-spal", label=<<FONT POINT-SIZE="9">Лемма 2.1.2</FONT><BR/><B>Сравнение числа обычных и<BR/>рассеянных палиндромов</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-pal-spal", tooltip="Лемма 2.1.2. Сравнение числа обычных и рассеянных палиндромов. Без проверки Lean. "];
"mahalingam-increment" [id="node-mahalingam-increment", label=<<FONT POINT-SIZE="9">Лемма 2.1.3</FONT><BR/><B>Добавление буквы даёт не более<BR/>Fₙ новых рассеянных палиндромов</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-mahalingam-increment", tooltip="Лемма 2.1.3. Добавление буквы даёт не более Fₙ новых рассеянных палиндромов. Без проверки Lean. "];
"brinkhuis" [id="node-brinkhuis", label=<<FONT POINT-SIZE="9">Предложение 2.1.3</FONT><BR/><B>Экспоненциальные оценки числа<BR/>троичных бесквадратных слов</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-brinkhuis", tooltip="Предложение 2.1.3. Экспоненциальные оценки числа троичных бесквадратных слов. Без проверки Lean. "];
}
subgraph "cluster_2.2" {
graph [label="§ 2.2", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"weyl" [id="node-weyl", label=<<FONT POINT-SIZE="9">Теорема 2.2.1</FONT><BR/><B>Критерий Вейля</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-weyl", tooltip="Теорема 2.2.1. Критерий Вейля. Доказано. Доказана эквивалентность для частот полуинтервалов и средних всех ненулевых гармоник. Обратный переход получен равномерной аппроксимацией непрерывной функции на окружности по полуоткрытым дугам."];
"lem:logfact" [id="node-lem-logfact", label=<<FONT POINT-SIZE="9">Лемма 2.2.1</FONT><BR/><B>Равномерное распределение<BR/>log_b(n!) при b &gt; 1</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-logfact", tooltip="Лемма 2.2.1. Равномерное распределение log_b(n!) при b > 1. Доказано. Доказаны равномерное распределение и попадания в любой полуинтервал положительной длины за любой заданной границей."];
"factorial-correlations" [id="node-factorial-correlations", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Приближение корреляций степенями<BR/>с мнимым показателем</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-factorial-correlations", tooltip="Шаг доказательства. Приближение корреляций степенями с мнимым показателем. Доказано. "];
"oscillation-integral" [id="node-oscillation-integral", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Сравнение осциллирующей суммы с<BR/>интегралом</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-oscillation-integral", tooltip="Шаг доказательства. Сравнение осциллирующей суммы с интегралом. Доказано. "];
"correlation-limit" [id="node-correlation-limit", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Предел модуля нормированной<BR/>корреляционной суммы</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-correlation-limit", tooltip="Шаг доказательства. Предел модуля нормированной корреляционной суммы. Доказано. "];
"weyl-mean" [id="node-weyl-mean", label=<<FONT POINT-SIZE="9">Шаг доказательства</FONT><BR/><B>Оценка Коши и два предельных<BR/>перехода в средних Вейля</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-weyl-mean", tooltip="Шаг доказательства. Оценка Коши и два предельных перехода в средних Вейля. Доказано. "];
"lem:lead" [id="node-lem-lead", label=<<FONT POINT-SIZE="9">Лемма 2.2.2</FONT><BR/><B>Любой ненулевой ведущий блок<BR/>встречается бесконечно часто</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-lead", tooltip="Лемма 2.2.2. Любой ненулевой ведущий блок встречается бесконечно часто. Доказано. Любой допустимый префикс с ненулевой первой цифрой появляется в сколь угодно поздних факториалах."];
"lem:trail" [id="node-lem-trail", label=<<FONT POINT-SIZE="9">Лемма 2.2.3</FONT><BR/><B>Число концевых нулей n!<BR/>стремится к бесконечности</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-trail", tooltip="Лемма 2.2.3. Число концевых нулей n! стремится к бесконечности. Доказано. Проверены точная формула через показатели простых, монотонность и стремление числа концевых нулей к бесконечности."];
"p03" [id="node-p03", label=<<FONT POINT-SIZE="9">Предложение 2.2.2</FONT><BR/><B>Факторная и арифметическая<BR/>сложности произвольного слова</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-p03", tooltip="Предложение 2.2.2. Факторная и арифметическая сложности произвольного слова. Доказано. Для произвольного слова над конечным алфавитом доказана цепочка p(k) ≤ a(k) ≤ |A|^k через прогрессии шага один и включение в множество всех слов длины k."];
"mainthm01" [id="node-mainthm01", label=<<FONT POINT-SIZE="9">Теорема 2.2.3 · Новизна 6 · Защита 4</FONT><BR/><B>Конкатенация факториалов имеет<BR/>обе сложности bᵏ</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", fillcolor="#FFEB80", URL="coverage.md#node-mainthm01", tooltip="Теорема 2.2.3. Конкатенация факториалов имеет обе сложности bᵏ. Доказано. Обе сложности бесконечной конкатенации над Fin b равны b^k."];
}
subgraph "cluster_3.1" {
graph [label="§ 3.1", labeljust=l, style="rounded", color="#C8D0D5", margin=14];
"fib-binomial" [id="node-fib-binomial", label=<<FONT POINT-SIZE="9">Формула</FONT><BR/><B>Две биномиальные суммы для Fₙ и<BR/>Fₙ₊₁</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-fib-binomial", tooltip="Формула. Две биномиальные суммы для Fₙ и Fₙ₊₁. Без проверки Lean. Исправленный сдвиг индекса следует из подсчёта покрытий плитками длины 1 и 2."];
"defn1pil" [id="node-defn1pil", label=<<FONT POINT-SIZE="9">Определение 3.1.2</FONT><BR/><B>Существование и единственность<BR/>рекурсии порядка k+p−1</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-defn1pil", tooltip="Определение 3.1.2. Существование и единственность рекурсии порядка k+p−1. Доказано. Для исправленной нормировки r = k + p − 1 доказаны существование и единственность рекурсии с единицей на позиции r−1."];
"lemgenn1" [id="node-lemgenn1", label=<<FONT POINT-SIZE="9">Лемма 3.1.1</FONT><BR/><B>Производящая функция<BR/>нормированной рекурсии</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lemgenn1", tooltip="Лемма 3.1.1. Производящая функция нормированной рекурсии. Доказано. Умножение формальных рядов проверено по коэффициентам, включая специализацию p = 1."];
"thmconsn1" [id="node-thmconsn1", label=<<FONT POINT-SIZE="9">Теорема 3.1.1</FONT><BR/><B>Критический и асимптотический<BR/>показатели штурмова слова</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-thmconsn1", tooltip="Теорема 3.1.1. Критический и асимптотический показатели штурмова слова. Без проверки Lean. В TeX наклон нормирован, а асимптотический показатель равен 2 + limsup(qₙ₊₁/qₙ)."];
"sturmian-powers" [id="node-sturmian-powers", label=<<FONT POINT-SIZE="9">Внешний результат</FONT><BR/><B>Классификация примитивных корней<BR/>кубов в штурмовом языке</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-sturmian-powers", tooltip="Внешний результат. Классификация примитивных корней кубов в штурмовом языке. Без проверки Lean. "];
"fibonacci-exponent" [id="node-fibonacci-exponent", label=<<FONT POINT-SIZE="9">Следствие в тексте</FONT><BR/><B>Для слова Фибоначчи E = E* = 2+φ</B><BR/><FONT POINT-SIZE="9">Без проверки Lean</FONT>>, color="#C43735", URL="coverage.md#node-fibonacci-exponent", tooltip="Следствие в тексте. Для слова Фибоначчи E = E* = 2+φ. Без проверки Lean. "];
"lem:fibA" [id="node-lem-fiba", label=<<FONT POINT-SIZE="9">Лемма 3.1.2</FONT><BR/><B>Тождества Бине и пределы<BR/>отношений чисел Фибоначчи</B><BR/><FONT POINT-SIZE="9">Доказано</FONT>>, color="#228044", URL="coverage.md#node-lem-fiba", tooltip="Лемма 3.1.2. Тождества Бине и пределы отношений чисел Фибоначчи. Доказано. Проверены тождества Бине и все три предела отношений из lem:fibA."];
}
